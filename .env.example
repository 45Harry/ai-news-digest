# Copy this file to .env and fill in your own values.

# ---- Pick your summarizer chain ----
# Providers are tried in the order listed below; the first one that answers
# wins. If one throws an error (bad key, quota, outage) it's skipped and the
# next is tried -- so you can enable several and never worry about a single
# provider going down. Add a key to any provider below to enable it.
LLM_PROVIDERS=anthropic,groq,nim,cerebras,gemini,huggingface,openai,opencode_zen,ollama
# (Optional single-provider override -- uncomment and set to force one provider.)
# LLM_PROVIDER=gemini

# ---- Model per task ----
# Each LLM task runs its OWN chain (defaults to the global LLM_PROVIDERS list).
# Leave a task blank to fall back to the global chain. Entries accept `name@model`
# to pin a specific model of a provider, e.g.:
#   VERIFY_LLM_PROVIDERS=ollama@llama3.1
#   OVERVIEW_LLM_PROVIDERS=gemini@gemini-3.8-flash
# Suggested split: verify = small/cheap/fast model (dedup + junk check),
# overview = your best writer model.
VERIFY_LLM_PROVIDERS=
OVERVIEW_LLM_PROVIDERS=

# ---- Ollama (local, free, private -- no key needed) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Only set if your Ollama instance requires auth (e.g. a remote box).
OLLAMA_API_KEY=

# ---- OpenCode Zen ----
# Get a key at https://opencode.ai/auth. Free-tier models as of writing:
# big-pickle, deepseek-v4-flash-free, mimo-v2.5-free, nemotron-3-super-free
# (check the Zen dashboard for the current list).
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle

# ---- Google Gemini (OpenAI-compatible endpoint) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Hugging Face (Inference Providers, OpenAI-compatible router) ----
# Get a key at https://huggingface.co/settings/tokens (read + write) or
# https://huggingface.co/settings/inference-provider
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ---- Groq (OpenAI-compatible endpoint, very fast) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Cerebras (OpenAI-compatible endpoint, world's-fastest inference) ----
# Get a key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# ---- NVIDIA NIM (free, no credit card, OpenAI-compatible) ----
# Get a key at https://build.nvidia.com/explore
NIM_API_KEY=
NIM_MODEL=moonshotai/kimi-k3

# ---- OpenAI (used if OPENAI_API_KEY is set) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic (used if ANTHROPIC_API_KEY is set) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Gmail SMTP ----
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT your normal Gmail password)
GMAIL_ADDRESS=harrysmart499@gmail.com
GMAIL_APP_PASSWORD=
MAIL_TO=harrysmart499@gmail.com

# ---- AI Lab Updates & Tweets ----
# Lab Updates: official lab blogs (OpenAI, Google AI, DeepMind, Mistral, Meta,
# HuggingFace) + AI announcement searches (Anthropic, DeepSeek, Qwen, Moonshot,
# xAI, Zhipu). Edit LAB_AI_FEEDS / LAB_ANNOUNCE_QUERIES in src/config.py.
#
# Lab Tweets: official X accounts, fetched via the template below (RSSHub by
# default). X blocks anonymous reads and public RSSHub instances are usually
# overloaded, so this section only fills in when TWITTER_RSS_TEMPLATE points at
# a working (e.g. self-hosted) RSSHub/Nitter instance; otherwise it is skipped.
AI_TWITTER_ACCOUNTS=OpenAI,AnthropicAI,GoogleDeepMind,GoogleAI,GeminiApp,deepseek_ai,Alibaba_Qwen,MoonshotAI,zhipu_ai,MistralAI,xai,AIatMeta
TWITTER_RSS_TEMPLATE=https://rsshub.app/twitter/user/{user}

# ---- Behavior ----
# How often the loop checks feeds (seconds). 300 = every 5 minutes.
RUN_INTERVAL_SECONDS=300
# Cap of items per category that go into one email.
MAX_ARTICLES_PER_RUN=20
# How long a link is remembered (so it won't be re-sent).
SEEN_TTL_DAYS=14
# Heat score above which a story is "big/unique" and triggers an instant BREAKING email.
HOT_THRESHOLD=65
# 1 (default) = only email articles published today; 0 = email anything in the feeds.
FILTER_TODAY_ONLY=1
# With FILTER_TODAY_ONLY=1, how many previous days (plus today) to include.
# 1 = yesterday + today; 2 = two days + today. Matters for a morning digest.
RECENCY_DAYS=1
# 1 = instant real-time BREAKING emails (needs the 24/7 watcher running).
# 0 (default) = no separate breaking alerts; the daily digest covers everything.
BREAKING_ALERTS=0